{
  "lastChangelogVersion": "1.6.1",
  "theme": "ayu-dark",
  "quietStartup": "header",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.4",
  "packages": [
    {
      "source": "npm:pi-subagents",
      "prompts": []
    },
    {
      "source": "npm:@upstash/context7-pi",
      "prompts": []
    },
    "npm:pi-web-access"
  ],
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.90.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0"
  },
  "extensions": [],
  "enabledModels": [
    "opencode-go/claude-haiku-5-5",
    "opencode-go/gemini-4-argon",
    "opencode-go/kimi-k3",
    "opencode-go/kimi-k3.1-pro",
    "opencode-go/gpt-6-luna",
    "opencode-go/grok-4.7",
    "zai/glm-5.3",
    "zai/glm-5.3-flash",
    "zai/glm-5.4"
  ],
  "defaultThinkingLevel": "medium",
  "subagents": {
    "defaultModel": "zai/glm-5.3-flash",
    "defaultInheritGlobalContext": true,
    "agentOverrides": {
      "reviewer": {
        "model": "zai/glm-5.3"
      },
      "oracle": {
        "model": "zai/glm-5.3"
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      }
    },
    "watchdog": {
      "enabled": true,
      "main": {
        "model": "zai/glm-5.3",
        "thinking": "high"
      },
      "scope": {
        "enabled": true
      },
      "cadence": {
        "everyNTools": 25
      },
      "children": {
        "enabled": true,
        "model": "zai/glm-5.3-flash",
        "cadence": {
          "everyNTools": 20
        },
        "overrides": {
          "reviewer": {
            "enabled": false
          },
          "oracle": {
            "enabled": false
          }
        }
      }
    }
  }
}